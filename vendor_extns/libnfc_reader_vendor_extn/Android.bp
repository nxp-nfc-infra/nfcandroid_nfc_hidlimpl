cc_defaults {
    name: "extn_defaults",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-implicit-fallthrough",
        "-Wno-unused-parameter",
    ],
    srcs: [
        "src/api/NfcExtensionApi.cpp",
        "src/common/log/phNxpLog.cc",
        "src/common/utils/phNxpConfig.cc",
        "src/common/utils/config.cc",
        "src/core/controller/NfcExtensionController.cpp",
        "src/core/nfc_comm/NfcExtensionWriter.cpp",
        "src/core/handler/DefaultEventHandler.cpp",
        "src/pal/common/PalIntervalTimer.cpp",
        "src/pal/common/PalThreadMutex.cc",
        "src/pal/common/PlatformBase.cpp",
        "src/features/nci_state_monitor/NciStateMonitor.cpp",
        "src/features/nci_state_monitor/RfStateMonitor.cpp",
        "src/features/tda/src/TdaHandler.cpp",
        "src/features/tda/src/Tda.cpp",
        "src/features/tda/src/api/tda_api.cc",
        "src/features/tda/src/ct/tda.cc",
        "src/features/tda/src/nci/nci_snd.cc",
        "src/features/tda/src/nci/nci_rcv.cc",
        "src/features/tda/src/fsm/fsm.cc",
        "src/features/tda/src/pal/pal.cc",
        "src/features/softpos/src/SoftPosHandler.cpp",
    ],
    export_include_dirs: [
        "inc/common",
        "src/common",
        "src/common/inc",
        "src/common/log",
        "src/common/utils",
        "src/core/controller",
        "src/core/nfc_comm",
        "src/core/handler",
        "src/pal/common",
        "src/features/nci_state_monitor",
        "src/features/tda/inc",
        "src/features/softpos/inc",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libdl",
    ],
}


cc_library_shared {
    name: "libnfc_reader_vendor_extn_vnd",
    stem: "libnfc_reader_vendor_extn",
    proprietary: true,
    enabled: true,
    defaults: [
        "extn_defaults",
    ],
    export_include_dirs: [
        "src/pal/vendor_ext",
        "src/features/nci_state_monitor",
    ],
    srcs: [
        "src/pal/vendor_ext/PlatformAbstractionLayer.cpp",
    ],
    include_dirs: [
        "hardware/nxp/nfc/nfc_reader/halimpl/common",
        "hardware/nxp/nfc/nfc_reader/halimpl/hal",
        "hardware/nxp/nfc/nfc_reader/halimpl/nfc_extn",
        "hardware/nxp/nfc/nfc_reader/halimpl/tml",
        "hardware/nxp/nfc/nfc_reader/halimpl/softpos/",
    ],
    shared_libs: [
        "nfc_nci_nxp_reader",
    ],
}




cc_binary {
    name: "tda_sm_test",

    srcs: [
        "src/features/tda_test/tda_sm_test.cpp",
    ],

    shared_libs: [
        "liblog",
        "libnfc_reader_vendor_extn_vnd",
    ],

    include_dirs: [
        "hardware/nxp/nfc/vendor_extns/libnfc_reader_vendor_extn/inc",
        "hardware/nxp/nfc/vendor_extns/libnfc_reader_vendor_extn/src/features/tda/inc",
    ],

    cflags: [
        "-Wall",
    ],
}
